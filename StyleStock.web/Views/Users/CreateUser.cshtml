@using StyleStock.Domain.DTOS
@model CreateUsersDTO
@{
	ViewData["Title"] = "Agregar Usuario";
}

<div class="row">
	<div class="col-6 ">
		<h2>Nuevo Usuario</h2>
		<form asp-controller="Users" asp-action="CreateUser" method="post">
			<div class="mb-2">
				<lable for="name" class="form-label">Nombre </lable>
				<input class="form-control" asp-for="FirstName" id="name" type="text" placeholder="Nombre" required />
			</div>

			<div class="mb-2">
				<lable for="LastName" class="form-label">Apellido</lable>
				<input class="form-control" asp-for="LastName" id="LastName" type="text" placeholder="Telefono" required />
			</div>

			<div class="mb-2">
				<lable for="email" class="form-label">Correo electronico</lable>
				<input class="form-control" asp-for="Email" id="email" type="text" placeholder="Correo Electronico" required />
			</div>

			<div class="mb-2">
				<lable for="password" class="form-label">Contraseña</lable>
				<input class="form-control" asp-for="PasswordHash" id="password" type="text" placeholder="Contraseña" required />
			</div>

			<div class="mb-2">
				<label for="rol" class="form-label">Rol</label>
				<select class="form-control" asp-for="Role" id="rol" required>
					<option value="Admin">Admin</option>
					<option value="Usuario">Usuario</option>
				</select>
			</div>

			<div class="mb-3">
				<button class="btn btn-primary" type="submit">Guardar</button>
				<a asp-controller="Suppliers" asp-action="Index" class="btn btn-danger">Cancelar</a>
			</div>
		</form>
	</div>
</div>